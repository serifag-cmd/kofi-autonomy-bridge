[application]
config/name="DALMA Genesis 3D Runtime"
run/main_scene="res://scenes/genesis.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.027,0.031,0.043,1)

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027,0.031,0.043,1)
